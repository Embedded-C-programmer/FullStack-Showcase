# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/rag_platform
MONGODB_URI_TEST=mongodb://localhost:27017/rag_platform_test

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_random_hex_chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=CHANGE_ME_different_64_random_hex_chars
JWT_REFRESH_EXPIRE=7d
MAX_REFRESH_TOKENS=5

# ── Python AI Service ──────────────────────────────────────────────────────
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_TIMEOUT_MS=600000
PYTHON_CHAT_TIMEOUT_MS=90000
INTERNAL_API_SECRET=CHANGE_ME_shared_secret_with_python_service

# ── File Upload ────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
SLOW_DOWN_DELAY_AFTER=50
SLOW_DOWN_DELAY_MS=500

# ── Storage Quotas ─────────────────────────────────────────────────────────
DEFAULT_STORAGE_LIMIT_BYTES=524288000
ADMIN_STORAGE_LIMIT_BYTES=5368709120

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ── Security ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
