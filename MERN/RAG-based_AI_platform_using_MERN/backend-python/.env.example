ENVIRONMENT=development
LOG_LEVEL=debug

# ── LLM Backend ────────────────────────────────────────────────────────────
# Choose ONE of: auto | openai | ollama | none
#
#  auto   = tries openai first, then ollama, then falls back to chunk display
#  openai = OpenAI API (needs OPENAI_API_KEY + internet)
#  ollama = local Ollama (free, no key — see Ollama section below)
#  none   = no LLM — displays raw document excerpts as answers (always works)
#
LLM_BACKEND=auto

# ── Option A: OpenAI ───────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Leave empty to skip OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.2

# ── Option B: Ollama (free, local, no API key) ─────────────────────────────
# 1. Install Ollama:  https://ollama.com/download
# 2. Pull a model:    ollama pull llama3.2
# 3. Start server:    ollama serve
# Then set LLM_BACKEND=ollama (or leave as auto — it will be found)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embedding model ────────────────────────────────────────────────────────
# Downloads automatically on first startup (~22 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── FAISS ─────────────────────────────────────────────────────────────────
FAISS_INDEX_DIR=./faiss_indices
FAISS_DIMENSION=384      # must match EMBEDDING_MODEL dimension

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── RAG ───────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
MIN_SIMILARITY_SCORE=0.3

# ── Node API ──────────────────────────────────────────────────────────────
NODE_API_URL=http://localhost:5000
